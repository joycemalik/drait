# Copy to .env.local. Leave these empty to run on bundled sample data (read-only, no sign-in).

# From `npx supabase start` (local) or your project's Settings → API page (cloud).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: shown in the footer, and used to count contributors.
NEXT_PUBLIC_REPO_URL=
